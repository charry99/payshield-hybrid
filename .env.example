# ---------------------------------------------------------------------------
# PayShield Hybrid — Firebase configuration
#
# Copy this file to ".env" and fill in your own Firebase project's values
# (Firebase console > Project settings > Your apps > Web app > SDK setup).
#
# Without these values the app still loads and the offline rule engine still
# works — only the AI second opinion is disabled ("AI not configured").
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: measurement id (not required for AI Logic).
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: cloud Gemini model used when inference falls back to the cloud.
# Defaults to the SDK's hybrid default when left empty.
VITE_CLOUD_MODEL=

# ---------------------------------------------------------------------------
# Firebase App Check
#
# AI Logic enforces App Check. For production, register the Fraud Defense
# (reCAPTCHA Enterprise) provider in the Firebase console (App Check > Apps)
# and put its site key here — classic reCAPTCHA v3 key registration is
# deprecated by Firebase. For local development / the hackathon demo, leave
# the site keys empty and instead use a debug token:
#
#   1. Set VITE_APPCHECK_DEBUG_TOKEN=true below.
#   2. Run `npm run dev`, open the app, and copy the debug token printed in
#      the browser console ("AppCheck debug token: ...").
#   3. In the Firebase console: App Check > Apps > your web app >
#      Manage debug tokens > register that token.
#
# (You can also paste a fixed debug token UUID instead of "true".)
# ---------------------------------------------------------------------------
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
VITE_RECAPTCHA_SITE_KEY=
VITE_APPCHECK_DEBUG_TOKEN=
